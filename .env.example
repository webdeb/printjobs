# Docker Image (can be overridden per server/runner)
DOCKER_IMAGE=ghcr.io/webdeb/printjobs:latest

# Web UI and API Port
PORT=3001

# Optional Admin PIN to protect printer setup, tariff edits, and cash settlements
# Leave empty to allow unrestricted LAN access
ADMIN_PIN=

# Path to SQLite database inside container
DB_PATH=/data/printjobs.sqlite

# Path to camera snapshot cache directory inside container
CACHE_DIR=/data/camera_cache

# MeTe Member System (optional, e.g. http://mete.local:1337)
METE_URL=
METE_SYNC_INTERVAL_MINS=15
